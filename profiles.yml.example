customer_project:
  target: dev
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST', '') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH', '') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'main') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'dbt_dev') }}"
      azure_client_id: "{{ env_var('DATABRICKS_AZURE_CLIENT_ID', '') }}"
      azure_client_secret: "{{ env_var('DATABRICKS_AZURE_CLIENT_SECRET', '') }}"
      auth_type: azure-client-secret
      threads: 4
    ci:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST', '') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH', '') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'main') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'dbt_ci') }}"
      azure_client_id: "{{ env_var('DATABRICKS_AZURE_CLIENT_ID', '') }}"
      azure_client_secret: "{{ env_var('DATABRICKS_AZURE_CLIENT_SECRET', '') }}"
      auth_type: azure-client-secret
      threads: 4
